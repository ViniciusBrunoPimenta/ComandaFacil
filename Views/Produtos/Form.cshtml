@model Produto
@{
    var novo = Model.Id == 0;
    ViewData["Title"] = novo ? "Novo produto" : "Editar produto";
    var precoDigitado = ViewData.ModelState[nameof(Produto.Preco)]?.AttemptedValue
        ?? (Model.Preco > 0 ? Model.Preco.ToString("0.00") : "");
}

<div class="formulario">
    <h1 class="titulo mb-3">@ViewData["Title"]</h1>

    <form asp-action="@(novo ? "Criar" : "Editar")" asp-route-id="@(novo ? null : Model.Id)" method="post" class="bloco">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" placeholder="Ex.: X-Salada" autofocus />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-sm-5">
                <label asp-for="Preco" class="form-label"></label>
                <input asp-for="Preco" id="preco" value="@precoDigitado" type="text" inputmode="decimal" class="form-control" placeholder="0,00" />
                <span asp-validation-for="Preco" class="text-danger"></span>
            </div>
            <div class="col-sm-7">
                <label asp-for="CategoriaId" class="form-label"></label>
                <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
                    <option value="0">Escolha a categoria</option>
                </select>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-check form-switch mb-4">
            <input asp-for="Ativo" class="form-check-input" role="switch" />
            <label asp-for="Ativo" class="form-check-label"></label>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Salvar produto</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Aceita "12.50" e converte para o formato brasileiro "12,50"
        document.querySelector('form').addEventListener('submit', function () {
            var preco = document.getElementById('preco');
            if (preco.value.indexOf('.') >= 0 && preco.value.indexOf(',') < 0)
                preco.value = preco.value.replace('.', ',');
        });
    </script>
}
