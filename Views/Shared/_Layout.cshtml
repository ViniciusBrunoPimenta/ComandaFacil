@{
    var logado = User.Identity?.IsAuthenticated == true;
    var ehAdmin = User.IsInRole(nameof(PerfilUsuario.Administrador));
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ComandaFácil</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (logado)
    {
        <nav class="navbar navbar-expand-md barra" data-bs-theme="dark">
            <div class="container-xl">
                <a class="navbar-brand marca" asp-controller="Mesas" asp-action="Index">ComandaFácil</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Abrir menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Mesas" asp-action="Index">Mesas</a></li>
                        @if (ehAdmin)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Produtos" asp-action="Index">Produtos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Relatorios" asp-action="VendasDoDia">Vendas do dia</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3 py-2 py-md-0">
                        <span class="text-white-50">@User.Identity!.Name</span>
                        <form asp-controller="Conta" asp-action="Sair" method="post" class="m-0">
                            <button type="submit" class="btn btn-outline-light">Sair</button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    }

    <main class="container-xl py-3 py-md-4">
        @if (TempData["Sucesso"] is string sucesso)
        {
            <div class="alert alert-success aviso" role="status">@sucesso</div>
        }
        @if (TempData["Erro"] is string erro)
        {
            <div class="alert alert-danger aviso" role="alert">@erro</div>
        }

        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Pede confirmação em botões com data-confirmar="mensagem"
        document.addEventListener('submit', function (e) {
            var botao = e.submitter;
            var mensagem = (botao && botao.dataset.confirmar) || e.target.dataset.confirmar;
            if (mensagem && !window.confirm(mensagem)) e.preventDefault();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
