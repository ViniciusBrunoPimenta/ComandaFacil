@model Categoria
@{
    var nova = Model.Id == 0;
    ViewData["Title"] = nova ? "Nova categoria" : "Editar categoria";
}

<div class="formulario">
    <h1 class="titulo mb-3">@ViewData["Title"]</h1>

    <form asp-action="@(nova ? "Criar" : "Editar")" asp-route-id="@(nova ? null : Model.Id)" method="post" class="bloco">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-4">
            <label asp-for="Nome" class="form-label"></label>
            <input asp-for="Nome" class="form-control" placeholder="Ex.: Lanches" autofocus />
            <span asp-validation-for="Nome" class="text-danger"></span>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Salvar categoria</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
