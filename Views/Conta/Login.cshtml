@model LoginViewModel
@{
    ViewData["Title"] = "Entrar";
}
<div class="login">
    <h1 class="login-marca">ComandaFácil</h1>
    <p class="text-secondary mb-4">Entre para ver as mesas.</p>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="bloco">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Login" class="form-label"></label>
            <input asp-for="Login" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Login" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Senha" class="form-label"></label>
            <input asp-for="Senha" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Senha" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Entrar</button>
    </form>

    <p class="dica mt-3">Para testar: <strong>admin</strong> / admin123 ou <strong>atendente</strong> / atendente123</p>
</div>
