@startuml caso-de-uso
!include 00-estilo.iuml
left to right direction
title ComandaFácil — Diagrama de Casos de Uso

actor "Atendente" as AT
actor "Administrador\n(dono)" as AD
AD -|> AT

rectangle "ComandaFácil" {
  usecase "UC01 - Gerenciar produtos\ne categorias" as UC01
  usecase "UC02 - Abrir comanda\nem uma mesa" as UC02
  usecase "UC03 - Lançar/remover\nitens na comanda" as UC03
  usecase "UC04 - Fechar comanda" as UC04
  usecase "UC05 - Consultar\nvendas do dia" as UC05
  usecase "Realizar login" as LOGIN
}

AT --> UC02
AT --> UC03
AT --> UC04
AD --> UC01
AD --> UC05

UC01 ..> LOGIN : <<include>>
UC02 ..> LOGIN : <<include>>
UC03 ..> LOGIN : <<include>>
UC04 ..> LOGIN : <<include>>
UC05 ..> LOGIN : <<include>>
@enduml
